# Leitura do conteúdo no servidor. Não coloque tokens reais neste arquivo.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
SANITY_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# O Studio roda no navegador e precisa destas três configurações públicas.
# Repita aqui o mesmo projectId, dataset e apiVersion usados acima.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
